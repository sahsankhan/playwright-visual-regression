{
  "name": "playwright-visual-regression",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright built-in visual regression against Toolshop UI.",
  "scripts": {
    "test": "node src/utils/run.js",
    "test:headed": "node src/utils/run.js --headed",
    "test:smoke": "node src/utils/run.js --grep @smoke",
    "test:update-snapshots": "playwright test --update-snapshots",
    "report": "playwright show-report",
    "report:summary": "node src/utils/visualReport.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7"
  }
}
